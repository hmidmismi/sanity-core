{
  "extends": "@chorusworks/tsconfig/tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "noEmit": true,
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "src/**/*",
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
